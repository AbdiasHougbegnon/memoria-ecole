# Copier en .env (jamais commite) et renseigner les valeurs reelles.
# Toutes les variables Azure sont optionnelles : le backend degrade
# gracieusement (log + fonctionnalite desactivee) si elles sont vides.

# Obligatoire en production (signature des JWT) -- valeur aleatoire d'au
# moins 32 caracteres, gardee hors du code.
MEMORIA_JWT_SECRET=

# Azure Speech (transcription + diarization)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Azure OpenAI (resumes, comptes rendus, embeddings)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Azure Document Intelligence (extraction PDF/photos)
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=

# Azure AI Search (recherche semantique)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=

# SMTP (rappels d'engagements) -- vide = envoi desactive (log uniquement)
MEMORIA_EMAIL_HOST=
MEMORIA_EMAIL_PORT=587
MEMORIA_EMAIL_USERNAME=
MEMORIA_EMAIL_PASSWORD=
